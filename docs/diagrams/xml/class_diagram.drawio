        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Backend {\n        +currentState State\n        +songStart time.Time\n        +songDuration float64\n        +voteYes int\n        +voteNo int\n        +setState(s State)\n        +analyzeAudio(path string) map\n        +callOllama(prompt, model) string\n        +saveToDB(db, path, metadata)\n        +getCandidates(db, file, mood) list\n    }\n    \n    class AudioMetadata {\n        +filepath string\n        +title string\n        +artist string\n        +duration float64\n        +bpm float64\n        +energy float64\n        +mood_label string\n        +key string\n    }\n    \n    class DirectorAgent {\n        +model string\n        +selectNextTrack(candidates, history) Song\n    }\n    \n    class DJAgent {\n        +model string\n        +generateIntro(currentSong, nextSong) string\n    }\n    \n    class ChatterboxTTS {\n        +model string\n        +synthesize(text) wav_path\n    }\n    \n    class Librarian {\n        +analyzeAudio(path) AudioMetadata\n        +extractBPM() float\n        +extractMood() string\n    }\n    \n    Backend --&gt; AudioMetadata\n    Backend --&gt; DirectorAgent\n    Backend --&gt; DJAgent\n    Backend --&gt; ChatterboxTTS\n    Backend --&gt; Librarian&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="u5meKP-RfrXWX0ofzs_9-1">
